# Local backend paths only. No cloud/robot/audio credentials are needed.
SIRCUS_MJLAB_STUDY=/absolute/path/to/completed/study
SIRCUS_MJLAB_ASSETS=/absolute/path/to/sircus-isaac/assets
SIRCUS_MJLAB_GPU_LOCK=/absolute/path/to/sircus-isaac/scene.lock
# Optional completed learned-bank study: free requests use its categorical
# selector; positional-lock requests retain the continuous parent policy.
SIRCUS_MJLAB_BANK_STUDY=/absolute/path/to/completed/bank-study
# Select the existing pinned environment when launching the HTTP server.
# python -m sircus.mjlab.interface --study-report "$SIRCUS_MJLAB_STUDY/report.json" \
#   --solver sircus.mjlab.learning_interface:solve --host 127.0.0.1 --port 18781
